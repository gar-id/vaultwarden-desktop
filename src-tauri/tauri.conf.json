{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vaultwarden Desktop",
  "version": "0.1.0",
  "identifier": "com.vaultwarden.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vaultwarden Desktop",
        "width": 1100,
        "height": 680,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Vaultwarden & Bitwarden desktop client",
    "longDescription": "A lightweight, secure, cross-platform desktop client for Vaultwarden and Bitwarden.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
